# Neon operacional: origem SOMENTE LEITURA. Nunca use um role com permissões de escrita.
# Certificado e hostname precisam ser validados: sslmode=verify-full.
PRODUCTION_DATABASE_URL=postgresql://analytics_sync_ro:change-me@neon-host/segundo_prod?sslmode=verify-full

# Banco exclusivo de analytics no MongoDB Atlas, TLS verificado.
MONGODB_URI=mongodb+srv://analytics-user:change-me@your-cluster.mongodb.net/
# O nome do database é intencionalmente mantido por compatibilidade com os dados da POC.
MONGODB_DATABASE=ouros_analytics_poc

# GitHub Actions repository variable (não usado para execuções locais).
MONGO_SYNC_ENABLED=true
